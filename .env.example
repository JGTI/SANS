# Application
APP_NAME="Nexus Space Apps"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Runtime
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Sessions
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Services and storage
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache
CACHE_STORE=database
# CACHE_PREFIX=

# Memcached
MEMCACHED_HOST=127.0.0.1

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.nexusdigitaldb.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@nexusdigitaldb.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@nexusdigitaldb.com"
MAIL_FROM_NAME="NEXUS DIGITAL DB"

# Contact
CONTACT_RECIPIENTS="github.jgge@gmail.com"
CONTACT_CC="josegarcia@nexusdigitaldb.com"
CONTACT_SEND_CONFIRMATION=true

# reCAPTCHA
RECAPTCHA_SITE_KEY=6Lft4r8tAAAAAEkHnQIXRHKUDO0aG-3IMYdaMl0v
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MINIMUM_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES="sans-visualrehabcenter-spaceappschallenge.nexusdigitaldb.com,nexusdigitaldb.com,www.nexusdigitaldb.com,localhost"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend
VITE_APP_NAME="${APP_NAME}"

# Public storage
PUBLIC_STORAGE_PATH=

# Nexus maintenance
NEXUS_MAINTENANCE_ENABLED=false
NEXUS_MAINTENANCE_KEY=

# Debugging
DEBUGBAR_ENABLED=false

# SEO
SEO_SITE_NAME=
SEO_DEFAULT_TITLE=
SEO_DEFAULT_DESCRIPTION=
SEO_SITEMAP_ENABLED=true

# Space Vision Scientific Engine (Python & FastAPI)
SCIENTIFIC_ENGINE_URL=http://127.0.0.1:8001
SCIENTIFIC_ENGINE_TOKEN=spacevision-scientific-secret-token-2026
SCIENTIFIC_ENGINE_TIMEOUT=4.0
